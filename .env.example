# ==============================================================================
# Agent Compliance Card Generator - Environment Configurations
# ==============================================================================

# FastAPI Backend Options
API_V1_STR=/api/v1
PROJECT_NAME="Agent Compliance Card Generator"

# Cryptography & Security (Keep secret in production!)
SECRET_KEY=supersecretkeythatisatleast32characterslongforsecurity
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Connections
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compliance_db

# Redis Caching & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_PER_MINUTE=60

# OpenAI API Integration (Optional fallback to rule-based engine if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
